# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/
# Dockerfile.web runs a frozen pnpm install that reads the workspace-wide
# lock, which records a patchedDependencies entry for the mobile patch. The
# build context must include it (but not the whole mobile workspace) so the
# frozen install can resolve the lock.
!/apps/mobile/patches/

# Repository-only tooling
/.github/
/deploy/
/scripts/
