{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "testflight": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "staging",
        "EXPO_ENABLE_APNS": "1"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_ENABLE_APNS": "1"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
